Package: grazer
Title: Ingest, Clean, and Analyse Cattle GPS Data
Version: 0.1.0
Authors@R: 
    person(c("Dr", "Thomas"), "Williams", email = "t.m.williams@cqu.edu.au", role = c("aut", "cre"))
